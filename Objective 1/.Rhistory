path_spec <- here("Objective 1", "Data", "external", "spec_tab_v2025-03-31.xlsx")
path_pop  <- here("Objective 1", "Data", "external", "pop_tab_v2025-03-31.xlsx")
path_out  <- here("Objective 1", "Data", "interim", "GenDiv_filtered.csv")
#| label: read-species
sp_raw <- read_xlsx(path_spec)
